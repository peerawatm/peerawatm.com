{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "peerawatm-com",
  "main": "src/index.js",
  "workers_dev": false,
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peerawatm-hits",
      "database_id": "d231fdbc-5381-4d1c-9b6e-1d657a2bbbe6"
    }
  ]
}
