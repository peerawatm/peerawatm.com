# Custom response headers for Cloudflare Workers static assets.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Baseline security headers (X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, HSTS, CSP) are already sent by the Cloudflare zone, so they
# are intentionally not duplicated here.

# Font names carry a content hash, so they never go stale.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Artwork keeps a stable name, so cache it briefly.
/outlier/*.png
  Cache-Control: public, max-age=3600

# Defense in depth for the work-in-progress page; the meta tag is the primary.
/outlier/*
  X-Robots-Tag: noindex, nofollow

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
