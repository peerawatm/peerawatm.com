# Custom response headers for Cloudflare Workers static assets.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Baseline security headers (X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, HSTS, CSP) are already sent by the Cloudflare zone, so they
# are intentionally not duplicated here.

# Font is a stable, rarely-changed asset; cache it for 30 days.
/fonts/*
  Cache-Control: public, max-age=2592000
